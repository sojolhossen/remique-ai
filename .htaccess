<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent direct access to sensitive configuration files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan) - [F,L]

    # Redirect root subfolder to public/
    RewriteCond %{REQUEST_URI} !^/remi/public/
    RewriteRule ^(.*)$ /remi/public/$1 [L,R=301]
</IfModule>
